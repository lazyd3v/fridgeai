{
  "name": "fridge-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test server/*.test.ts",
    "pi:sync": "bash scripts/pi.sh sync",
    "pi:setup": "bash scripts/pi.sh setup",
    "pi:run": "bash scripts/pi.sh run",
    "pi:logs": "bash scripts/pi.sh logs",
    "pi:restart": "bash scripts/pi.sh restart",
    "pi:tunnel": "bash scripts/pi.sh tunnel",
    "pi:sensor:on": "bash scripts/pi.sh sensor-on",
    "pi:sensor:off": "bash scripts/pi.sh sensor-off",
    "pi:sensor:check": "bash scripts/pi.sh sensor-check"
  },
  "dependencies": {
    "@openai/agents": "^0.21.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0"
  }
}
