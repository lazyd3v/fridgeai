HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# demo | replay | usb
CAMERA_MODE=demo
# For replay: absolute path to a saved JPEG or PNG
REPLAY_IMAGE=
# For usb: install ffmpeg on the Pi
CAMERA_DEVICE=/dev/video0
CAMERA_SIZE=640x480
CAMERA_FPS=10
# Set to mjpeg if supported by your webcam; leave empty for automatic input.
CAMERA_INPUT_FORMAT=
# Optional ALSA override; otherwise match the microphone to CAMERA_DEVICE via USB sysfs.
# Example: plughw:CARD=Webcam,DEV=0 (use arecord -L on the Pi).
CAMERA_AUDIO_DEVICE=
# Enable only after wiring and checking the door switch.
DOOR_SENSOR_ENABLED=false
DOOR_GPIO_CHIP=gpiochip0
DOOR_GPIO_LINE=17
# GPIO level with the magnet nearby (door closed). Change to 1 if reversed.
DOOR_CLOSED_LEVEL=0
DOOR_DEBOUNCE_MS=250

# Server-side only. Agent model is gpt-6-luna.
OPENAI_API_KEY=
